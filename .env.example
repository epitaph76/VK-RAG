# Copy to .env. Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=
SESSION_SECRET=
# For HTTPS behind a reverse proxy, set SECURE_COOKIE=1.
SECURE_COOKIE=0
# Set 0.0.0.0 for externally reachable HTTP; put HTTPS in front for production.
BIND_ADDRESS=127.0.0.1
PORT=8090
SUB2API_API_KEY=
SUB2API_BASE_URL=
SUB2API_MODEL=gpt-5.6-luna
SUB2API_NETWORK=sub2api_sub2api-network
MODEL_THREADS=4
MODELS_ENABLED=1
LAYA_KEEP_THRESHOLD=0.8
# Context admission heuristics, not calibrated relevance probabilities.
CONTEXT_MIN_RERANK_SCORE=0
CONTEXT_MIN_DENSE_SCORE=0.78
CONTEXT_MIN_TERM_COVERAGE=0.6
SOURCE_DOCUMENT_LIMIT=100
ASK_RATE_PER_MINUTE=5
SEARCH_RATE_PER_MINUTE=30
PIPELINE_QUEUE_SIZE=4
